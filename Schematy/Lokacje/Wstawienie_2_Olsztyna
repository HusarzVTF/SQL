INSERT INTO Stacja_Paliw.Lokacje.Miejscowosc (IDGminy, Miejscowosc)

SELECT  IdGminy, 'Olsztyn'
FROM Stacja_Paliw.Lokacje.Gmina G
INNER JOIN Stacja_Paliw.Lokacje.Powiat P ON G.IdPowiatu = P.IdPowiatu 
WHERE P.Powiat = 'Częstochowski' AND G.Gmina = 'Olsztyn'
