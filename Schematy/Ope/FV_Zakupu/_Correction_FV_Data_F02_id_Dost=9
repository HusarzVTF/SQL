UPDATE d
SET d.ID_Dat = k.ID
FROM Ope.Dostawy d
INNER JOIN Czas.Kalendarz k 
    ON k.Data = CAST(d.CzasTransakcji AS Date)
WHERE d.NRFV = 'F02' 
  AND d.IdDostawcy = 9;

