USE Stacja_Paliw;


GO


 IF OBJECT_ID('Ope.uspWiekowanie') IS NOT NULL
 DROP PROC Ope.uspWiekowanie;

 --Instukcja sprawdzająca czy istnieje już procedura Ope.uspWiekowanie jeśli tak to jest likwidowana. Zakładamy, że jeśli istnieje to przez pomyłkę--
GO

CREATE PROC Ope.uspWiekowanie ( @co varchar(max), @jakie varchar(max), @paliwo_1 varchar(max), @paliwo_2 varchar(max), @paliwo_3 varchar(max) ) 


 
 AS


 
 /*walidacja*/

IF LEN(@co) > 12 THROW  1602001, 'Wprowadzono za długi parametr co.', 1;

IF LEN(@jakie) > 18 THROW  1602002, 'Wprowadzono za długi parametr jakie.', 1;

IF LEN(@paliwo_1) > 7 THROW  1602003, 'Wprowadzono za długi parametr paliwo_1.', 1;

IF LEN(@paliwo_2) > 7 THROW  1602004, 'Wprowadzono za długi parametr paliwo_2.', 1;

IF LEN(@paliwo_3) > 7 THROW  1602005, 'Wprowadzono za długi parametr paliwo_3.', 1;



DECLARE @Dzis date = GETDATE()

DECLARE @DzisStr varchar(10) = CONVERT(varchar(10), @Dzis, 120) 

DECLARE @paliwaCheck varchar(3) 


DECLARE @palNull varchar(7) =  COALESCE(@paliwo_1,@paliwo_2,@paliwo_3)


IF EXISTS (
	          (SELECT *   FROM (VALUES (@paliwo_1), (@paliwo_2), (@paliwo_3)) AS P(Paliwo)
            WHERE P.Paliwo IS NOT NULL AND P.Paliwo NOT IN (SELECT RodzajPaliwa FROM Ope.Zbiorniki)))

BEGIN

SET @paliwaCheck = 'zle'

END

CREATE TABLE #paliwa (paliwo varchar(7))

INSERT INTO #paliwa

SELECT @paliwo_1
UNION ALL
SELECT @paliwo_2
UNION ALL
SELECT @paliwo_3


IF 

	(@jakie NOT IN ('przeterminowane','nieprzeterminowane','calkowite') OR  (@jakie IS NULL))

 OR

	(@co NOT IN ('naleznosci','zobowiazania') OR (@co IS NULL))
	
 OR
	
 (@palNull IS NULL)
	
 OR  
	
 @paliwaCheck = 'zle'
	
 OR

 (@co = 'zobowiazania' AND @jakie = 'calkowite' AND NOT EXISTS (
	                                                                SELECT 1 FROM Ope.Dostawy AS D JOIN Ope.Zbiorniki AS Z ON D.IDPaliw = Z.IDPaliwa 
	                                                                WHERE RodzajPaliwa IN (SELECT paliwo FROM #paliwa) AND	DataZaplaty IS NULL) )
	OR

	(@co = 'naleznosci' AND @jakie = 'calkowite' AND NOT EXISTS (
	                                                              SELECT 1 FROM Ope.Sprzedaz AS S JOIN Ope.Zbiorniki AS Z ON S.IDPaliwa = Z.IDPaliwa
	                                                              WHERE RodzajPaliwa IN (SELECT paliwo FROM #paliwa) AND DataZaplaty IS NULL) )
 OR

 (@co = 'naleznosci' AND @jakie = 'nieprzeterminowane' 	AND NOT EXISTS (
	                                                                        SELECT 1 FROM Ope.Sprzedaz AS S JOIN Ope.Zbiorniki AS Z ON S.IDPaliwa = Z.IDPaliwa  
	                                                                        WHERE  RodzajPaliwa IN (SELECT paliwo FROM #paliwa) AND DataZaplaty IS NULL AND TerminZaplaty > @Dzis) ) 
 OR

 (@co = 'naleznosci' AND @jakie = 'przeterminowane' AND NOT EXISTS (
	                                                                    SELECT 1 FROM Ope.Sprzedaz AS S JOIN Ope.Zbiorniki AS Z ON S.IDPaliwa = Z.IDPaliwa 
	                                                                    WHERE RodzajPaliwa IN (SELECT paliwo FROM #paliwa) AND DataZaplaty IS NULL AND TerminZaplaty < @Dzis) )
	OR

(@co = 'zobowiazania' AND @jakie = 'nieprzeterminowane' AND NOT EXISTS (
	                                                                     SELECT 1 FROM Ope.Dostawy AS D JOIN Ope.Zbiorniki AS Z ON D.IDPaliw = Z.IDPaliwa 
	                                                                     WHERE RodzajPaliwa IN (SELECT paliwo FROM #paliwa) AND DataZaplaty IS NULL AND TerminZaplaty > @Dzis) )
	OR

(@co = 'zobowiazania' AND @jakie = 'przeterminowane' AND NOT EXISTS (
	                                                                   SELECT 1 FROM Ope.Dostawy AS D JOIN Ope.Zbiorniki AS Z ON D.IDPaliw = Z.IDPaliwa 
	                                                                   WHERE RodzajPaliwa IN (SELECT paliwo FROM #paliwa) AND DataZaplaty IS NULL AND TerminZaplaty < @Dzis) )



BEGIN

DECLARE @msg nvarchar(200);

IF @paliwaCheck IS NULL AND (COALESCE(@paliwo_1,@paliwo_2,@paliwo_3) IS NOT NULL) AND (@jakie IN ('przeterminowane','nieprzeterminowane','calkowite')) 
AND @co IN ('naleznosci','zobowiazania')
   
   BEGIN

   DECLARE @listaPaliw NVARCHAR(200) = '';

    IF @paliwo_1 IS NOT NULL 
    SET @listaPaliw = @paliwo_1;

    IF @paliwo_2 IS NOT NULL 
    SET @listaPaliw = CASE 
                        WHEN @listaPaliw = '' THEN @paliwo_2 
                        ELSE @listaPaliw + ', ' + @paliwo_2 
                      END;

    IF @paliwo_3 IS NOT NULL 
    SET @listaPaliw = CASE 
                        WHEN @listaPaliw = '' THEN @paliwo_3 
                        ELSE @listaPaliw + ', ' + @paliwo_3 
                      END;

  END

	IF @jakie NOT IN ('przeterminowane','nieprzeterminowane','calkowite') OR  (@jakie IS NULL)
		
		SET @msg = 'Podano błędny parametr jakie. Wyróżniamy przeterminowane, nieprzeterminowane i całkowite i tylko takie parametry przyjmuje procedura.'
    
	IF @co NOT IN ('naleznosci','zobowiazania') OR (@co IS NULL)
		
		SET @msg = 'Podano błędny parametr co. Wiekować mozna należności albo zobowiązania i tylko takie parametry przyjmuje procedura.'
	
	
	IF @palNull IS NULL
		
	   SET @msg = 'Trzeba podać przynajmniej jedno paliwo.'

	IF @paliwaCheck = 'zle'

		  SET @msg = 'Co najmniej jedno paliwo ma niepoprawny typ. Dozwolone: Ropa, Gaz, Benzyna.'

	IF	@co = 'zobowiazania' AND @jakie = 'calkowite' AND @palNull IS NOT NULL AND @paliwaCheck IS NULL

	   SET @msg = 'Brak zobowiazań. Dla wprowadzonych paliw: ' + @listaPaliw  + '.';

	IF	@co = 'naleznosci' AND @jakie = 'calkowite'  AND @palNull IS NOT NULL AND @paliwaCheck IS NULL

    SET @msg = 'Brak należności. Dla wprowadzonych paliw: ' + @listaPaliw  + '.';

	IF @co = 'naleznosci' AND @jakie = 'nieprzeterminowane'  AND @palNull IS NOT NULL AND @paliwaCheck IS NULL

    SET @msg = 'Brak należnosci spełniających podane kryteria: nieprzeterminowane. Dla wprowadzonych paliw: ' + @listaPaliw  + '.';

	IF @co = 'naleznosci' AND @jakie = 'przeterminowane' AND @palNull IS NOT NULL AND @paliwaCheck IS NULL

    SET @msg = 'Brak należności spełniających podane kryteria: przeterminowane. Dla wprowadzonych paliw: ' + @listaPaliw  + '.';

	IF @co = 'zobowiazania' AND @jakie = 'nieprzeterminowane' AND @palNull IS NOT NULL AND @paliwaCheck IS NULL
	
		  SET @msg = 'Brak zobowiazań spełniających podane kryteria: nieprzeterminowane. Dla wprowadzonych paliw: ' + @listaPaliw  + '.';

	IF @co = 'zobowiazania' AND @jakie = 'przeterminowane'  AND @palNull IS NOT NULL AND @paliwaCheck IS NULL

		  SET @msg = 'Brak zobowiazań spełniających podane kryteria: przeterminowane. Dla wprowadzonych paliw: ' + @listaPaliw  + '.';
		    

 THROW 1701001, @msg, 1;

END



/*koniec walidacji*/

/* domyslnie deklarujemy pod Naleznosci */



DECLARE @obiekt varchar(12) = 'Ope.Sprzedaz'

DECLARE @kol varchar(10) = 'IdKlienta'

DECLARE @alias varchar(13) = 'NazwaKlienta'

DECLARE @kontrahenci varchar(12) = 'Ope.Klienci'

DECLARE @rodzaj varchar(12) = 'Naleznosci'

DECLARE @paliwaSql NVARCHAR(MAX)

DECLARE @kolpaliwa varchar(8) = 'IDPaliwa' 

SELECT @paliwaSql = STRING_AGG(QUOTENAME(paliwo, ''''), ',') 
FROM #paliwa
WHERE paliwo IS NOT NULL


DECLARE @sql NVARCHAR(MAX)

/* napdisujemy dla zobowiazan*/

IF @co = 'zobowiazania'

BEGIN 

SET @obiekt  = 'Ope.Dostawy'

SET @kol = 'IdDostawcy'  

SET @alias = 'NazwaDostawcy'

SET @kontrahenci = 'Ope.Dostawcy'

SET @rodzaj = 'Zobowiazania'

SET @kolpaliwa = 'IDPaliw'

END

DECLARE @kod NVARCHAR(MAX)

IF @jakie = 'calkowite'

BEGIN

SET @kod = '1=1'

END


IF @jakie != 'calkowite'

BEGIN

SET @kod = 'Rodzaj=''' + @jakie + ''''

END






/*DYNAMIC SQL PONIZEJ*/

SET @sql = 
'WITH CTE_Data AS (
SELECT ' + @kol +  ',Pogrupowane,SUM(KwotaBrutto) AS KwotaBrutto
FROM (
					  SELECT ' + @kol +  ',SUM(KwotaBrutto) AS KwotaBrutto,Rodzaj, 
					  CASE 
	            WHEN Rodzaj = ''przeterminowane'' THEN
	            CASE 
			          WHEN Dni > 0 AND Dni <= 30 THEN ''Przet do 30 dni''
             WHEN Dni > 30 AND Dni <= 60 THEN ''Przet od 30 do 60 dni''
			          WHEN Dni > 60 AND Dni <= 90 THEN ''Przet od 60 do 90 dni''
			          WHEN Dni > 90 AND Dni <= 120 THEN ''Przet od 90 do 120 dni''
			          WHEN Dni > 120 AND Dni <= 150 THEN ''Przet od 120 do 150 dni''
             WHEN Dni > 150 AND Dni <= 180 THEN ''Przet od 150 do 180 dni''
             WHEN Dni > 180 THEN ''Przet pow 180 dni''
             ELSE ''Brak''
             END
             
             WHEN Rodzaj = ''nieprzeterminowane'' THEN
             CASE 
             WHEN Dni > 0 AND Dni <= 30 THEN ''Niepr do 30 dni''
             WHEN Dni > 30 AND Dni <= 60 THEN ''Niepr od 30 do 60 dni''
             WHEN Dni > 60 AND Dni <= 90 THEN ''Niepr od 60 do 90 dni''
             WHEN Dni > 90 AND Dni <= 120 THEN ''Niepr od 90 do 120 dni''
             WHEN Dni > 120 AND Dni <= 150 THEN ''Niepr od 120 do 150 dni''
             WHEN Dni > 150 AND Dni <= 180 THEN ''Niepr od 150 do 180 dni''
             WHEN Dni > 180 THEN ''Niepr pow 180 dni''
             ELSE ''Brak''
             END
            
    ELSE ''Brak''
    END AS Pogrupowane


						FROM (

							 SELECT '
							 + @kol+'  , ROUND(SUM(KwotaBrutto),2) AS KwotaBrutto,


							 CASE 

							 WHEN TerminZaplaty < ''' + @DzisStr + ''' THEN ''przeterminowane''
							 ELSE ''nieprzeterminowane''

							 END AS Rodzaj,  



							 CASE 

							 WHEN  TerminZaplaty < ''' + @DzisStr + ''' THEN DATEDIFF(d,TerminZaplaty,''' + @DzisStr + ''') 
							 WHEN  TerminZaplaty >= ''' + @DzisStr + ''' THEN DATEDIFF(d,''' + @DzisStr + ''',TerminZaplaty)
							 
							 END AS Dni
							 							 													 

							FROM ' + @obiekt + ' AS S
							LEFT JOIN Ope.Zbiorniki AS Z ON Z.IDPaliwa=S.' + @kolpaliwa + '  
							WHERE RodzajPaliwa IN  (' + @paliwaSql + ') 
							AND DataZaplaty IS NULL
							GROUP BY '+  @kol +',TerminZaplaty
					) AS Source

					WHERE (' + @kod + ') 
					GROUP BY ' + @kol + ' ,Rodzaj,Dni) AS S
					
GROUP BY ' + @kol +',Pogrupowane), 

		


CTE_Pivot AS (
    SELECT '
  
    + @kol +', 
		  [Przet do 30 dni],
    [Przet od 30 do 60 dni],
		  [Przet od 60 do 90 dni],
		  [Przet od 90 do 120 dni],
		  [Przet od 120 do 150 dni],
		  [Przet od 150 do 180 dni],
		  [Przet pow 180 dni],
		  [Niepr do 30 dni],
		  [Niepr od 30 do 60 dni],
		  [Niepr od 60 do 90 dni],
		  [Niepr od 90 do 120 dni],
		  [Niepr od 120 do 150 dni],
		  [Niepr od 150 do 180 dni],
		  [Niepr pow 180 dni]  

    FROM (
	          SELECT*FROM CTE_Data 
       
    ) AS SourceNal
    PIVOT (
           SUM(KwotaBrutto) FOR Pogrupowane IN ([Przet do 30 dni],[Przet od 30 do 60 dni],[Przet od 60 do 90 dni],[Przet od 90 do 120 dni]
		         ,[Przet od 120 do 150 dni],[Przet od 150 do 180 dni],[Przet pow 180 dni],[Niepr do 30 dni],[Niepr od 30 do 60 dni],[Niepr od 60 do 90 dni],
		         [Niepr od 90 do 120 dni],[Niepr od 120 do 150 dni],[Niepr od 150 do 180 dni],[Niepr pow 180 dni])
    ) AS Final
)



SELECT*INTO #Wynik FROM (

                          SELECT 
                          
                          K.' + @kol +  ',' + @alias  + ', 
                          ROUND(ISNULL([Niepr do 30 dni],0),2) +  ROUND(ISNULL([Niepr od 30 do 60 dni],0),2)  + ROUND(ISNULL([Niepr od 60 do 90 dni],0),2) 
                          + ROUND(ISNULL([Niepr od 90 do 120 dni],0),2) + ROUND(ISNULL([Niepr od 120 do 150 dni],0),2) + ROUND(ISNULL([Niepr od 150 do 180 dni],0),2) 
                          + ROUND(ISNULL([Niepr pow 180 dni],0),2) + ROUND(ISNULL([Przet do 30 dni],0),2) + ROUND(ISNULL([Przet od 30 do 60 dni],0),2) 
                          + ROUND(ISNULL([Przet od 60 do 90 dni],0),2) + ROUND(ISNULL([Przet od 90 do 120 dni],0),2) + ROUND(ISNULL([Przet od 120 do 150 dni],0),2)
                          + ROUND(ISNULL([Przet od 150 do 180 dni],0),2) + ROUND(ISNULL([Przet pow 180 dni],0),2) 
                          AS '+ @rodzaj+'Br_Razem' + ', 


                          ROUND(ISNULL([Niepr do 30 dni],0),2) +  ROUND(ISNULL([Niepr od 30 do 60 dni],0),2)  + ROUND(ISNULL([Niepr od 60 do 90 dni],0),2) 
                          + ROUND(ISNULL([Niepr od 90 do 120 dni],0),2) + ROUND(ISNULL([Niepr od 120 do 150 dni],0),2) + ROUND(ISNULL([Niepr od 150 do 180 dni],0),2) 
                          + ROUND(ISNULL([Niepr pow 180 dni],0),2) 
                          AS ' + @rodzaj + 'Br_Niepr' +', 

                          ROUND(ISNULL([Przet do 30 dni],0),2) +  ROUND(ISNULL([Przet od 30 do 60 dni],0),2)  + ROUND(ISNULL([Przet od 60 do 90 dni],0),2) 
                          + ROUND(ISNULL([Przet od 90 do 120 dni],0),2) + ROUND(ISNULL([Przet od 120 do 150 dni],0),2) + ROUND(ISNULL([Przet od 150 do 180 dni],0),2) 
                          + ROUND(ISNULL([Przet pow 180 dni],0),2) 
                          AS ' + @rodzaj + 'Br_Przet'+' , 


                          ROUND(ISNULL([Przet do 30 dni],0),2) AS [Przet do 30 dni],
                          ROUND(ISNULL([Niepr do 30 dni],0),2) AS [Niepr do 30 dni],
                          ROUND(ISNULL([Przet od 30 do 60 dni],0),2) AS [Przet od 30 do 60 dni],
                          ROUND(ISNULL([Niepr od 30 do 60 dni],0),2) AS [Niepr od 30 do 60 dni],
                          ROUND(ISNULL([Przet od 60 do 90 dni],0),2) AS [Przet od 60 do 90 dni],
                          ROUND(ISNULL([Niepr od 60 do 90 dni],0),2) AS [Niepr od 60 do 90 dni],
                          ROUND(ISNULL([Przet od 90 do 120 dni],0),2) AS [Przet od 90 do 120 dni],
                          ROUND(ISNULL([Niepr od 90 do 120 dni],0),2) AS [Niepr od 90 do 120 dni],
                          ROUND(ISNULL([Przet od 120 do 150 dni],0),2) AS [Przet od 120 do 150 dni],
                          ROUND(ISNULL([Niepr od 120 do 150 dni],0),2) AS [Niepr od 120 do 150 dni],
                          ROUND(ISNULL([Przet od 150 do 180 dni],0),2) AS [Przet od 150 do 180 dni],
                          ROUND(ISNULL([Niepr od 150 do 180 dni],0),2) AS [Niepr od 150 do 180 dni],
                          ROUND(ISNULL([Przet pow 180 dni],0),2)  AS [Przet pow 180 dni],
                          ROUND(ISNULL([Niepr pow 180 dni],0),2)  AS [Niepr pow 180 dni]


                          FROM ' + @kontrahenci +   ' AS K
                          LEFT JOIN CTE_Pivot AS P ON K.' + @kol  +' = P.' + @kol  +'

                          UNION ALL

                          SELECT

                          (SELECT MAX(' + @kol  + ')  FROM ' + @kontrahenci +   ')  + 1
                           ,''Suma''
                           ,ROUND(ISNULL(
                                         ROUND(SUM(ISNULL([Niepr do 30 dni],0)),2) +  ROUND(SUM(ISNULL([Niepr od 30 do 60 dni],0)),2)  + ROUND(SUM(ISNULL([Niepr od 60 do 90 dni],0)),2) 
                                         + ROUND(SUM(ISNULL([Niepr od 90 do 120 dni],0)),2) + ROUND(SUM(ISNULL([Niepr od 120 do 150 dni],0)),2) + ROUND(SUM(ISNULL([Niepr od 150 do 180 dni],0)),2) 
                                         + ROUND(SUM(ISNULL([Niepr pow 180 dni],0)),2) + ROUND(SUM(ISNULL([Przet do 30 dni],0)),2) +  ROUND(SUM(ISNULL([Przet od 30 do 60 dni],0)),2)  
                                         + ROUND(SUM(ISNULL([Przet od 60 do 90 dni],0)),2) + ROUND(SUM(ISNULL([Przet od 90 do 120 dni],0)),2) + ROUND(SUM(ISNULL([Przet od 120 do 150 dni],0)),2) 
                                         + ROUND(SUM(ISNULL([Przet od 150 do 180 dni],0)),2) + ROUND(SUM(ISNULL([Przet pow 180 dni],0)),2) 
                                         ,0),2)
                           
                          ,ROUND(ISNULL(
                                        ROUND(SUM(ISNULL([Niepr do 30 dni],0)),2) +  ROUND(SUM(ISNULL([Niepr od 30 do 60 dni],0)),2)  + ROUND(SUM(ISNULL([Niepr od 60 do 90 dni],0)),2) 
                                        + ROUND(SUM(ISNULL([Niepr od 90 do 120 dni],0)),2) + ROUND(SUM(ISNULL([Niepr od 120 do 150 dni],0)),2) + ROUND(SUM(ISNULL([Niepr od 150 do 180 dni],0)),2) 
                                        + ROUND(SUM(ISNULL([Niepr pow 180 dni],0)),2) 
                                        ,0),2)

                         ,ROUND(ISNULL(
                                        ROUND(SUM(ISNULL([Przet do 30 dni],0)),2) +  ROUND(SUM(ISNULL([Przet od 30 do 60 dni],0)),2)  + ROUND(SUM(ISNULL([Przet od 60 do 90 dni],0)),2) 
                                        + ROUND(SUM(ISNULL([Przet od 90 do 120 dni],0)),2) + ROUND(SUM(ISNULL([Przet od 120 do 150 dni],0)),2) + ROUND(SUM(ISNULL([Przet od 150 do 180 dni],0)),2)
                                        + ROUND(SUM(ISNULL([Przet pow 180 dni],0)),2) 
                                        ,0),2)
                        ,ROUND(ISNULL(SUM(ISNULL([Przet do 30 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Niepr do 30 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Przet od 30 do 60 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Niepr od 30 do 60 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Przet od 60 do 90 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Niepr od 60 do 90 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Przet od 90 do 120 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Niepr od 90 do 120 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Przet od 120 do 150 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Niepr od 120 do 150 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Przet od 150 do 180 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Niepr od 150 do 180 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Przet pow 180 dni],0)),0),2) ,
                         ROUND(ISNULL(SUM(ISNULL([Niepr pow 180 dni],0)),0),2) 


                         FROM CTE_Pivot
) AS Source



IF ''' + @jakie + '''=''przeterminowane''

BEGIN


      SELECT ' +
      @kol + ', 
      ' + @alias + ', 
      ' + @rodzaj + 'Br_Przet' + ', 
	     [Przet do 30 dni],
      [Przet od 30 do 60 dni],
      [Przet od 60 do 90 dni],
      [Przet od 90 do 120 dni],
      [Przet od 120 do 150 dni],
      [Przet od 150 do 180 dni],
      [Przet pow 180 dni]

      FROM #Wynik
      ORDER BY ' + @kol+'; 

END


IF ''' + @jakie + '''=''nieprzeterminowane''

BEGIN

       SELECT '
       + @kol+', 
       ' + @alias+', 
       ' + @rodzaj + 'Br_Niepr' + ' , 
       [Niepr do 30 dni],
       [Niepr od 30 do 60 dni],
       [Niepr od 60 do 90 dni],
       [Niepr od 90 do 120 dni],
       [Niepr od 120 do 150 dni],
       [Niepr od 150 do 180 dni],
       [Niepr pow 180 dni]

    
       FROM #Wynik 
       ORDER BY ' + @kol + '; 

END


IF ''' + @jakie +'''=''calkowite''

BEGIN

       SELECT '
       + @kol + ',  
       ' + @alias +', 
       ' + @rodzaj + 'Br_Razem' + ', 
       ' + @rodzaj + 'Br_Niepr' + ', 
       ' + @rodzaj + 'Br_Przet' + ', 
       [Przet do 30 dni],
       [Niepr do 30 dni],
       [Przet od 30 do 60 dni],
       [Niepr od 30 do 60 dni],
       [Przet od 60 do 90 dni],
       [Niepr od 60 do 90 dni],
       [Przet od 90 do 120 dni],
       [Niepr od 90 do 120 dni],
       [Przet od 120 do 150 dni],
       [Niepr od 120 do 150 dni],
       [Przet od 150 do 180 dni],
       [Niepr od 150 do 180 dni],
       [Przet pow 180 dni],
       [Niepr pow 180 dni]


       FROM  #Wynik 
       ORDER BY ' + @kol	   + '

END;

DROP TABLE #Wynik, #paliwa'


EXEC sp_executesql @sql

/* procedura na wiekowanie naleznosci i zobowiazan */

