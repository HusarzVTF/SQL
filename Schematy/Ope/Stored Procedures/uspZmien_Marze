
USE Stacja_Paliw

GO

IF OBJECT_ID('Ope.uspZmien_Marze') IS NOT NULL
DROP PROC Ope.uspZmien_Marze;

/* instrukcja sprawdzajaca czy istnieje juz procedura Ope.uspZmien_Marze jesli tak to zakladamy, ze istniala przez pomylke 
i zostanie zlikwidowana a pwostanie nowa */

GO

CREATE PROC Ope.uspZmien_Marze(@rdz varchar(max), @marza decimal(5,4))

AS

DECLARE @trim_rdz varchar(max) = LTRIM(RTRIM(@rdz))

IF LEN(@trim_rdz) > 7 THROW  1000002, 'Wprowadzono za długi rodzaj paliwa.', 1;

IF @trim_rdz NOT IN (SELECT RodzajPaliwa FROM Ope.Zbiorniki) THROW 1000003, 'Wprowadzono paliwo, ktorego nie ma zbiornikach.', 1;


UPDATE Ope.Zbiorniki SET Marza = @marza WHERE RodzajPaliwa = @trim_rdz

/*procedura na aktualizacje marz w tabeli Zbiorniki*/


